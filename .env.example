# ===== ACROBIT backend — variables de entorno =====

# Puerto del servidor
PORT=3000

# MongoDB Atlas — pega aquí tu connection string.
# La base de datos es ACROBIT_BD (ya incluida en la URI).
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/ACROBIT_BD?retryWrites=true&w=majority

# JWT
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# CORS — orígenes del frontend (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:8100,https://localhost,capacitor://localhost

# Firebase Admin (login Google + push)
FIREBASE_PROJECT_ID=acrobit-app
GOOGLE_APPLICATION_CREDENTIALS=./src/firebase/acrobit-app-firebase-adminsdk-fbsvc-XXXXX.json

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=6000

# Cron T-10 en serverless (Bearer hacia /api/internal/t10-tick)
CRON_SECRET=cambia-esto-por-un-secreto-largo
